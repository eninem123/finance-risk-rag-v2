# Finance-Risk-RAG 环境变量配置示例
# ==================================
# 复制此文件为 .env 并填写您的配置

# ==================== LLM API 配置 ====================
# 必填：设置您的API密钥
# OpenAI API密钥（如果使用OpenAI）
OPENAI_API_KEY=your_openai_api_key_here

# Moonshot API密钥（如果使用Moonshot）
MOONSHOT_API_KEY=your_moonshot_api_key_here

# LLM提供商选择
# 可选值: openai, moonshot
LLM_PROVIDER=moonshot

# API基础URL
LLM_BASE_URL=https://api.moonshot.cn/v1

# 模型名称
LLM_MODEL_NAME=moonshot-v1-8k

# ==================== 嵌入模型配置 ====================
# 嵌入模型后端
# 可选值: onnx, sentence_transformers
EMBEDDING_BACKEND=onnx_or_sbert

# ==================== OCR 配置 ====================
# Tesseract可执行文件路径
# Windows示例: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac示例: /usr/bin/tesseract
TESSERACT_CMD=

# ==================== 处理配置 ====================
# 文本分块大小
CHUNK_SIZE=800

# 分块重叠大小
CHUNK_OVERLAP=100

# 最大上下文token数
MAX_CONTEXT_TOKENS=2000
